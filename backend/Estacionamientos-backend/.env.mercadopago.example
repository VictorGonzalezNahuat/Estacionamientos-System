# ==========================================
# VARIABLES DE ENTORNO - PAGOS (ABSTRACCION)
# ==========================================

# Proveedor activo: stripe | mercadopago
PAYMENT_PROVIDER=stripe

# URL base publica de tu backend (requerido para ambos)
WEBHOOK_URL=https://tu-dominio.com

# ------------------------------------------
# Stripe
# ------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SUCCESS_URL=https://tu-dominio.com/pago-exitoso?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://tu-dominio.com/pago-cancelado
STRIPE_CURRENCY=mxn

# ------------------------------------------
# MercadoPago
# ------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_xxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR_xxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_CURRENCY=MXN

# ==========================================
# NOTAS:
# ==========================================
# 1. Webhook generico recomendado:
#    https://tu-dominio.com/pagos/webhook
#
# 2. Endpoints de compatibilidad:
#    https://tu-dominio.com/pagos/webhook/stripe
#    https://tu-dominio.com/pagos/webhook/mercadopago
#
# 3. Si usas Cloudflare, crear regla WAF "Skip" para:
#    POST /pagos/webhook/stripe (y/o /pagos/webhook)
#    para evitar bloqueos 403 antes de llegar al backend.
